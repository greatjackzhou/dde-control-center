#!/bin/sh
# dde-env-write: 由 polkit(pkexec) 授权后以 root 身份安装系统级环境配置。
# 目标路径全部在本脚本内硬编码，调用方只能选择“模式 + 源临时文件”，
# 永远无法指定任意目标，杜绝任意文件写入。
#
# 支持模式：
#   environment <src>        安装 /etc/environment（兼容旧用法：仅一个参数时即此模式）
#   profile-d <src>          安装 /etc/profile.d/dde-control-center.sh（系统级 PATH 附加块）
#   profile-d-remove         删除 /etc/profile.d/dde-control-center.sh
#
# 安全性增强：
#   1. 原子替换：先复制到目标同目录的临时文件，再 mv 覆盖（rename 保证原子性）。
#   2. 内容校验：拒绝超大 / 含 NUL 的文件；environment 每行须为 KV/注释/空行；
#      profile-d 须携带约定的溯源头标记，防止误覆盖无关文件。
#   3. 备份回滚：替换前保留 .bak。
#
# environment 写入成功后尽力刷新 systemd-logind 全局环境（PATH 除外，见 refresh_logind）。
# 当前用户会话（systemctl --user）由插件进程自身负责，不在此处理。
# 用法: pkexec /usr/lib/dde-control-center/dde-env-write <mode> <src>
set -eu

ENV_TARGET="/etc/environment"
PROFILED_TARGET="/etc/profile.d/dde-control-center.sh"
# profile-d 文件必须包含此标记行才被接受安装（provenance 校验）
PROFILED_MARKER="# >>> dde-control-center managed PATH profile.d >>>"
MAX_SIZE=65536

usage() {
    echo "usage: dde-env-write [environment <src> | <src> | profile-d <src> | profile-d-remove]" >&2
}

# --- 模式分派（向后兼容：单个参数 = environment 模式） ---
if [ "$#" -eq 1 ]; then
    MODE="environment"
    SRC="$1"
elif [ "$#" -eq 2 ]; then
    MODE="$1"
    SRC="$2"
else
    usage
    exit 2
fi

# --- 源文件通用校验 ---
validate_src() {
    if [ ! -f "$SRC" ] || [ ! -r "$SRC" ]; then
        echo "source file not found or unreadable: $SRC" >&2
        exit 1
    fi
    SRC_SIZE=$(wc -c < "$SRC")
    if [ "$SRC_SIZE" -gt "$MAX_SIZE" ]; then
        echo "source file too large ($SRC_SIZE bytes, max $MAX_SIZE): possible corruption" >&2
        exit 1
    fi
    if grep -qP '\x00' "$SRC" 2>/dev/null; then
        echo "source file contains NUL bytes, refusing to write" >&2
        exit 1
    fi
}

# --- 原子安装到固定目标 ---
# $1 = 源文件, $2 = 目标文件；设置全局 OLD_SNAPSHOT 供后续 diff 使用
atomic_install() {
    _src="$1"
    _target="$2"
    _tdir=$(dirname "$_target")

    OLD_SNAPSHOT=$(mktemp)
    cp -f "$_target" "$OLD_SNAPSHOT" 2>/dev/null || : > "$OLD_SNAPSHOT"

    TMP_TARGET=$(mktemp "${_tdir}/.dde-env-XXXXXX")
    trap 'rm -f "$OLD_SNAPSHOT" "$TMP_TARGET"' EXIT

    cp "$_src" "$TMP_TARGET"
    # mktemp 默认 0600，而系统配置应为 0644 root:root
    chmod 0644 "$TMP_TARGET"
    chown root:root "$TMP_TARGET"

    if [ -f "$_target" ]; then
        cp -f "$_target" "$_target.bak" 2>/dev/null || true
    fi

    mv -f "$TMP_TARGET" "$_target"
    # 成功后 trap 只需清理快照
    trap 'rm -f "$OLD_SNAPSHOT"' EXIT
}

# 去除值的外围成对引号（与插件 EnvVarStore 的写入规则对应）
strip_quotes() {
    printf '%s' "$1" | sed -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*)'\$/\1/"
}

# 提取合法 KEY=VALUE 行（key 规则与插件 isValidVarName 一致）
list_kv() {
    sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=\(.*\)$/\1=\2/p' "$1"
}

list_keys() {
    sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$1" | sort -u
}

# 刷新 logind 环境：best-effort，任何失败都不影响文件写入结果
refresh_logind() {
    command -v loginctl >/dev/null 2>&1 || return 0

    # 新增/修改的变量逐条写入 logind 全局环境。
    # PATH 跳过：/etc/environment 中的 PATH 在登录时由 pam_env 处理，
    # 直接 set 会用文件值覆盖所有用户会话的标准 PATH；系统 PATH 的生效
    # 由 /etc/profile.d 附加块负责（profile-d 模式）。
    list_kv "$SRC" | while IFS= read -r line; do
        key=${line%%=*}
        value=${line#*=}
        [ "$key" = "PATH" ] && continue
        loginctl set-environment "$key=$(strip_quotes "$value")" 2>/dev/null || true
    done

    # 被删除的变量从 logind 环境撤销（同样跳过 PATH，回退登录期值）
    old_keys=$(mktemp)
    new_keys=$(mktemp)
    list_keys "$OLD_SNAPSHOT" > "$old_keys"
    list_keys "$SRC" > "$new_keys"
    comm -23 "$old_keys" "$new_keys" | while IFS= read -r key; do
        [ "$key" = "PATH" ] && continue
        loginctl unset-environment "$key" 2>/dev/null || true
    done
    rm -f "$old_keys" "$new_keys"
}

case "$MODE" in
    environment)
        validate_src
        # 内容格式校验：每行须为空行、#注释或 KEY=VALUE；允许空文件（清空系统变量）
        if [ -s "$SRC" ]; then
            BAD_LINES=$(grep -vP '^\s*$|^#|^[A-Za-z_][A-Za-z0-9_]*=' "$SRC" | head -5)
            if [ -n "$BAD_LINES" ]; then
                echo "source file contains malformed lines, refusing to write:" >&2
                echo "$BAD_LINES" >&2
                exit 1
            fi
        fi
        atomic_install "$SRC" "$ENV_TARGET"
        refresh_logind || true
        ;;

    profile-d)
        validate_src
        # provenance：仅接受带约定标记行的文件，避免误覆盖无关配置
        if ! grep -qF "$PROFILED_MARKER" "$SRC"; then
            echo "profile-d source missing provenance marker, refusing to write" >&2
            exit 1
        fi
        atomic_install "$SRC" "$PROFILED_TARGET"
        ;;

    profile-d-remove)
        rm -f "$PROFILED_TARGET"
        ;;

    *)
        usage
        exit 2
        ;;
esac

exit 0
